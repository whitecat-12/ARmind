<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>AR Saturnus — MindAR + Three.js</title>
    <script type="importmap">
        {
            "imports": {
                "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
                "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/",
                "mindar-image-three": "https://cdn.jsdelivr.net/npm/mind-ar@1.2.5/dist/mindar-image-three.prod.js"
            }
        }
    </script>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        html,
        body {
            height: 100%;
            overflow: hidden;
            background: #0b0f14;
            font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
        }

        #container {
            position: fixed;
            inset: 0;
            display: none;
            background: #000;
            overflow: hidden;
        }
        #container video,
        #container canvas {
            position: absolute;
        }

        #overlay {
            position: fixed;
            inset: 0;
            z-index: 10;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 30px;
            padding: 32px;
            background: radial-gradient(circle at 50% 30%, #1a1a24 0%, #0b0f14 70%);
            color: #e7f6f8;
            text-align: center;
        }
        #overlay h1 {
            font-size: 48px;
            font-weight: 700;
            letter-spacing: 1px;
            background: linear-gradient(135deg, #f5d78a, #d4a857);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin: 0;
            line-height: 1.2;
            text-shadow: 0 0 40px rgba(212, 168, 87, 0.15);
        }
        #startBtn {
            padding: 14px 36px;
            font-size: 18px;
            font-weight: 600;
            background: linear-gradient(135deg, #f5d78a, #d4a857);
            color: #1a1a1a;
            border: none;
            border-radius: 999px;
            cursor: pointer;
            transition: transform 0.15s ease, box-shadow 0.2s ease;
            box-shadow: 0 0 0 0 rgba(212, 168, 87, 0.3);
        }
        #startBtn:active {
            transform: scale(0.96);
        }
        #startBtn:hover {
            box-shadow: 0 0 32px 4px rgba(212, 168, 87, 0.3);
        }

        #statusMsg {
            font-size: 12px;
            color: #6f8890;
            min-height: 20px;
            opacity: 0;
            pointer-events: none;
            position: absolute;
            bottom: 20px;
        }

        #hud {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 20;
            display: none;
            align-items: center;
            justify-content: space-between;
            padding: 14px 18px;
            background: linear-gradient(180deg, rgba(0, 0, 0, 0.6), transparent);
            pointer-events: none;
        }
        #hud span {
            color: #fff;
            font-size: 13px;
            opacity: 0.85;
            text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
        }
        #stopBtn {
            pointer-events: auto;
            padding: 8px 18px;
            font-size: 13px;
            font-weight: 600;
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 999px;
            cursor: pointer;
            backdrop-filter: blur(6px);
            transition: background 0.2s;
        }
        #stopBtn:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        @media (max-width: 480px) {
            #overlay h1 {
                font-size: 32px;
            }
            #startBtn {
                padding: 12px 28px;
                font-size: 16px;
            }
        }
    </style>
</head>
<body>

    <div id="overlay">
        <h1>Start the adventure</h1>
        <button id="startBtn">🚀 Mulai AR</button>
        <p id="statusMsg"></p>
    </div>

    <div id="hud">
        <span>♄ Cari gambar target…</span>
        <button id="stopBtn">✕ Stop</button>
    </div>

    <div id="container"></div>

    <script type="module">
        import * as THREE from 'three';
        import { MindARThree } from 'mindar-image-three';

        // ─── DOM refs ───────────────────────────────────────────────
        const startBtn = document.getElementById('startBtn');
        const stopBtn = document.getElementById('stopBtn');
        const overlay = document.getElementById('overlay');
        const hud = document.getElementById('hud');
        const container = document.getElementById('container');
        const statusMsg = document.getElementById('statusMsg');

        let mindarThree = null;
        let fitRAF = null;
        let saturnGroup = null;
        let saturnMesh = null;
        let ringGroup = null;
        let stars = null;

        // ─── Fit "contain" untuk video & canvas ───────────────────
        function applyContainFit() {
            const video = container.querySelector('video');
            const canvas = container.querySelector('canvas');
            if (!video || !canvas || !video.videoWidth) return false;

            const cw = container.clientWidth;
            const ch = container.clientHeight;
            const videoRatio = video.videoWidth / video.videoHeight;
            const containerRatio = cw / ch;

            let w, h;
            if (videoRatio > containerRatio) {
                w = cw;
                h = cw / videoRatio;
            } else {
                h = ch;
                w = ch * videoRatio;
            }
            const left = (cw - w) / 2;
            const top = (ch - h) / 2;

            [video, canvas].forEach((el) => {
                el.style.width = `${w}px`;
                el.style.height = `${h}px`;
                el.style.left = `${left}px`;
                el.style.top = `${top}px`;
            });
            return true;
        }

        function waitAndFit() {
            if (!applyContainFit()) {
                fitRAF = requestAnimationFrame(waitAndFit);
            }
        }

        function onWindowResize() {
            applyContainFit();
        }

        // ─── Buat tekstur Saturnus (procedural) ────────────────────
        function createSaturnTexture() {
            const canvas = document.createElement('canvas');
            canvas.width = 2048;
            canvas.height = 1024;
            const ctx = canvas.getContext('2d');

            // 1. Warna dasar - kuning keemasan pucat
            const grad = ctx.createLinearGradient(0, 0, 0, canvas.height);
            grad.addColorStop(0, '#e8d5a8');
            grad.addColorStop(0.15, '#dcc49a');
            grad.addColorStop(0.3, '#e0c898');
            grad.addColorStop(0.5, '#d4b888');
            grad.addColorStop(0.7, '#c8ac78');
            grad.addColorStop(0.85, '#d4b888');
            grad.addColorStop(1, '#c8ac78');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // 2. Pita-pita horizontal (cloud bands) - lebih halus dari Jupiter
            const bands = [
                { y: 0.05, h: 0.03, color: 'rgba(200, 180, 150, 0.4)' },
                { y: 0.12, h: 0.05, color: 'rgba(180, 160, 130, 0.3)' },
                { y: 0.20, h: 0.04, color: 'rgba(210, 190, 160, 0.35)' },
                { y: 0.28, h: 0.06, color: 'rgba(170, 150, 120, 0.3)' },
                { y: 0.38, h: 0.04, color: 'rgba(200, 180, 150, 0.4)' },
                { y: 0.46, h: 0.08, color: 'rgba(190, 170, 140, 0.25)' },
                { y: 0.58, h: 0.05, color: 'rgba(180, 160, 130, 0.35)' },
                { y: 0.68, h: 0.04, color: 'rgba(210, 190, 160, 0.3)' },
                { y: 0.76, h: 0.06, color: 'rgba(170, 150, 120, 0.3)' },
                { y: 0.86, h: 0.04, color: 'rgba(200, 180, 150, 0.35)' },
                { y: 0.94, h: 0.04, color: 'rgba(180, 160, 130, 0.3)' },
            ];

            bands.forEach((b) => {
                const yPos = b.y * canvas.height;
                const height = b.h * canvas.height;
                ctx.fillStyle = b.color;
                ctx.fillRect(0, yPos, canvas.width, height);
            });

            // 3. Detail turbulensi halus
            for (let i = 0; i < 600; i++) {
                const x = Math.random() * canvas.width;
                const y = Math.random() * canvas.height;
                const r = Math.random() * 12 + 2;
                const alpha = Math.random() * 0.15 + 0.03;
                const hue = 40 + Math.random() * 20;
                ctx.beginPath();
                ctx.arc(x, y, r, 0, Math.PI * 2);
                ctx.fillStyle = `hsla(${hue}, 50%, 70%, ${alpha})`;
                ctx.fill();
            }

            // 4. Pola heksagonal di kutub utara (fitur khas Saturnus)
            const hexX = canvas.width * 0.25;
            const hexY = canvas.height * 0.08;
            const hexSize = canvas.width * 0.04;
            ctx.strokeStyle = 'rgba(160, 140, 110, 0.25)';
            ctx.lineWidth = 3;
            ctx.beginPath();
            for (let i = 0; i < 6; i++) {
                const angle = (i / 6) * Math.PI * 2 - Math.PI / 2;
                const px = hexX + hexSize * Math.cos(angle);
                const py = hexY + hexSize * Math.sin(angle);
                if (i === 0) ctx.moveTo(px, py);
                else ctx.lineTo(px, py);
            }
            ctx.closePath();
            ctx.stroke();

            // 5. Beberapa bintik-bintik badai kecil
            for (let i = 0; i < 30; i++) {
                const x = Math.random() * canvas.width;
                const y = Math.random() * canvas.height;
                const r = Math.random() * 15 + 5;
                const grad2 = ctx.createRadialGradient(x, y, 0, x, y, r);
                grad2.addColorStop(0, 'rgba(200, 180, 150, 0.15)');
                grad2.addColorStop(1, 'rgba(200, 180, 150, 0)');
                ctx.fillStyle = grad2;
                ctx.beginPath();
                ctx.arc(x, y, r, 0, Math.PI * 2);
                ctx.fill();
            }

            const tex = new THREE.CanvasTexture(canvas);
            tex.wrapS = THREE.RepeatWrapping;
            tex.wrapT = THREE.RepeatWrapping;
            tex.repeat.set(1, 1);
            return tex;
        }

        // ─── Buat tekstur cincin (procedural) ──────────────────────
        function createRingTexture() {
            const canvas = document.createElement('canvas');
            canvas.width = 2048;
            canvas.height = 128;
            const ctx = canvas.getContext('2d');

            // Latar belakang transparan
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Cincin utama - gradasi dari dalam ke luar
            // C ring (dalam, redup)
            const cStart = 0.05;
            const cEnd = 0.15;
            const gradC = ctx.createLinearGradient(
                canvas.width * cStart, 0,
                canvas.width * cEnd, 0
            );
            gradC.addColorStop(0, 'rgba(160, 140, 120, 0.2)');
            gradC.addColorStop(0.3, 'rgba(180, 160, 140, 0.4)');
            gradC.addColorStop(0.7, 'rgba(160, 140, 120, 0.3)');
            gradC.addColorStop(1, 'rgba(140, 120, 100, 0.15)');
            ctx.fillStyle = gradC;
            ctx.fillRect(canvas.width * cStart, 0, canvas.width * (cEnd - cStart), canvas.height);

            // Gap antara C dan B ring (Cassini division bagian dalam)
            const gap1Start = 0.15;
            const gap1End = 0.18;
            ctx.fillStyle = 'rgba(0,0,0,0)';
            ctx.fillRect(canvas.width * gap1Start, 0, canvas.width * (gap1End - gap1Start), canvas.height);

            // B ring (cincin utama, paling terang)
            const bStart = 0.18;
            const bEnd = 0.55;
            const gradB = ctx.createLinearGradient(
                canvas.width * bStart, 0,
                canvas.width * bEnd, 0
            );
            gradB.addColorStop(0, 'rgba(210, 190, 170, 0.5)');
            gradB.addColorStop(0.2, 'rgba(230, 210, 190, 0.7)');
            gradB.addColorStop(0.4, 'rgba(240, 220, 200, 0.8)');
            gradB.addColorStop(0.6, 'rgba(230, 210, 190, 0.7)');
            gradB.addColorStop(0.8, 'rgba(210, 190, 170, 0.5)');
            gradB.addColorStop(1, 'rgba(190, 170, 150, 0.35)');
            ctx.fillStyle = gradB;
            ctx.fillRect(canvas.width * bStart, 0, canvas.width * (bEnd - bStart), canvas.height);

            // Detail di dalam B ring - variasi kepadatan
            for (let i = 0; i < 200; i++) {
                const x = canvas.width * (bStart + Math.random() * (bEnd - bStart));
                const y = Math.random() * canvas.height;
                const w = 2 + Math.random() * 8;
                const h = 4 + Math.random() * 20;
                const alpha = Math.random() * 0.15;
                ctx.fillStyle = `rgba(180, 160, 140, ${alpha})`;
                ctx.fillRect(x, y, w, h);
            }

            // Cassini division (gap besar)
            const cassiniStart = 0.55;
            const cassiniEnd = 0.60;
            ctx.fillStyle = 'rgba(0,0,0,0)';
            ctx.fillRect(canvas.width * cassiniStart, 0, canvas.width * (cassiniEnd - cassiniStart), canvas.height);

            // A ring (cincin luar, lebih redup)
            const aStart = 0.60;
            const aEnd = 0.85;
            const gradA = ctx.createLinearGradient(
                canvas.width * aStart, 0,
                canvas.width * aEnd, 0
            );
            gradA.addColorStop(0, 'rgba(200, 180, 160, 0.4)');
            gradA.addColorStop(0.3, 'rgba(210, 190, 170, 0.5)');
            gradA.addColorStop(0.6, 'rgba(200, 180, 160, 0.4)');
            gradA.addColorStop(0.8, 'rgba(180, 160, 140, 0.3)');
            gradA.addColorStop(1, 'rgba(160, 140, 120, 0.2)');
            ctx.fillStyle = gradA;
            ctx.fillRect(canvas.width * aStart, 0, canvas.width * (aEnd - aStart), canvas.height);

            // Detail di dalam A ring
            for (let i = 0; i < 150; i++) {
                const x = canvas.width * (aStart + Math.random() * (aEnd - aStart));
                const y = Math.random() * canvas.height;
                const w = 1 + Math.random() * 5;
                const h = 3 + Math.random() * 15;
                const alpha = Math.random() * 0.12;
                ctx.fillStyle = `rgba(170, 150, 130, ${alpha})`;
                ctx.fillRect(x, y, w, h);
            }

            // Encke gap (di dalam A ring)
            const enckeStart = 0.72;
            const enckeEnd = 0.74;
            ctx.fillStyle = 'rgba(0,0,0,0)';
            ctx.fillRect(canvas.width * enckeStart, 0, canvas.width * (enckeEnd - enckeStart), canvas.height);

            // F ring (cincin tipis paling luar)
            const fStart = 0.88;
            const fEnd = 0.92;
            const gradF = ctx.createLinearGradient(
                canvas.width * fStart, 0,
                canvas.width * fEnd, 0
            );
            gradF.addColorStop(0, 'rgba(200, 180, 160, 0.1)');
            gradF.addColorStop(0.3, 'rgba(220, 200, 180, 0.25)');
            gradF.addColorStop(0.7, 'rgba(210, 190, 170, 0.2)');
            gradF.addColorStop(1, 'rgba(180, 160, 140, 0.05)');
            ctx.fillStyle = gradF;
            ctx.fillRect(canvas.width * fStart, 0, canvas.width * (fEnd - fStart), canvas.height);

            const tex = new THREE.CanvasTexture(canvas);
            tex.wrapS = THREE.RepeatWrapping;
            tex.wrapT = THREE.RepeatWrapping;
            tex.repeat.set(1, 1);
            return tex;
        }

        // ─── Buat cincin Saturnus dengan geometri tipis ──────────
        function createSaturnRings(innerRadius, outerRadius, texture) {
            const ringGroup = new THREE.Group();

            // Cincin utama menggunakan RingGeometry
            const geometry = new THREE.RingGeometry(innerRadius, outerRadius, 128);
            // Ubah UV agar tekstur radial terbaca dengan benar
            const pos = geometry.attributes.position;
            const uv = geometry.attributes.uv;
            const v3 = new THREE.Vector3();
            for (let i = 0; i < pos.count; i++) {
                v3.fromBufferAttribute(pos, i);
                const len = v3.length();
                // Normalisasi jarak dari pusat ke rentang 0-1
                const t = (len - innerRadius) / (outerRadius - innerRadius);
                uv.setXY(i, t, 0.5);
            }

            const material = new THREE.MeshBasicMaterial({
                map: texture,
                side: THREE.DoubleSide,
                transparent: true,
                opacity: 0.9,
                depthWrite: false,
            });

            const ring = new THREE.Mesh(geometry, material);
            ring.rotation.x = -Math.PI * 0.45; // Kemiringan cincin
            ringGroup.add(ring);

            // Cincin kedua untuk ketebalan (backside tipis)
            const geoBack = new THREE.RingGeometry(innerRadius, outerRadius, 128);
            const matBack = new THREE.MeshBasicMaterial({
                map: texture,
                side: THREE.BackSide,
                transparent: true,
                opacity: 0.5,
                depthWrite: false,
            });
            const ringBack = new THREE.Mesh(geoBack, matBack);
            ringBack.rotation.x = -Math.PI * 0.45;
            ringBack.position.z = -0.01;
            ringGroup.add(ringBack);

            return ringGroup;
        }

        // ─── Start AR ──────────────────────────────────────────────
        async function startAR() {
            try {
                statusMsg.textContent = '⏳ Meminta izin kamera…';

                mindarThree = new MindARThree({
                    container,
                    imageTargetSrc: 'targets/saturnus.mind', // ← file target Saturnus
                });

                const { renderer, scene, camera } = mindarThree;

                // ─── Pencahayaan ───────────────────────────────────
                const ambient = new THREE.AmbientLight(0x404060, 0.5);
                scene.add(ambient);

                const hemiLight = new THREE.HemisphereLight(0xffdd88, 0x332211, 0.7);
                scene.add(hemiLight);

                const dirLight = new THREE.DirectionalLight(0xffffff, 1.8);
                dirLight.position.set(2, 3, 2);
                scene.add(dirLight);

                const fillLight = new THREE.DirectionalLight(0xccaa88, 0.5);
                fillLight.position.set(-2, 0.5, -1);
                scene.add(fillLight);

                // ─── Anchor target ─────────────────────────────────
                const anchor = mindarThree.addAnchor(0);

                // ─── Buat Saturnus ─────────────────────────────────
                const planetRadius = 0.35;
                const texture = createSaturnTexture();

                const material = new THREE.MeshStandardMaterial({
                    map: texture,
                    roughness: 0.6,
                    metalness: 0.05,
                });

                const geometry = new THREE.SphereGeometry(planetRadius, 72, 72);
                saturnMesh = new THREE.Mesh(geometry, material);
                saturnGroup = new THREE.Group();
                saturnGroup.add(saturnMesh);

                // ─── Atmosfer / glow ──────────────────────────────
                const atmosMat = new THREE.MeshBasicMaterial({
                    color: 0xe8d5a8,
                    transparent: true,
                    opacity: 0.06,
                    side: THREE.BackSide,
                });
                const atmosGeo = new THREE.SphereGeometry(planetRadius * 1.06, 48, 48);
                const atmosMesh = new THREE.Mesh(atmosGeo, atmosMat);
                saturnGroup.add(atmosMesh);

                // ─── Cincin Saturnus ──────────────────────────────
                const ringTexture = createRingTexture();
                const innerR = planetRadius * 1.3;
                const outerR = planetRadius * 2.6;
                const ringObj = createSaturnRings(innerR, outerR, ringTexture);
                saturnGroup.add(ringObj);

                // ─── Tambahkan efek kilau pada cincin ─────────────
                // Cincin tipis tambahan untuk efek shimmer
                const shimmerMat = new THREE.MeshBasicMaterial({
                    color: 0xeeddbb,
                    transparent: true,
                    opacity: 0.05,
                    side: THREE.DoubleSide,
                    depthWrite: false,
                });
                const shimmerGeo = new THREE.RingGeometry(innerR * 0.9, outerR * 1.05, 128);
                const shimmerRing = new THREE.Mesh(shimmerGeo, shimmerMat);
                shimmerRing.rotation.x = -Math.PI * 0.45;
                saturnGroup.add(shimmerRing);

                anchor.group.add(saturnGroup);

                // ─── Bintang-bintang latar ─────────────────────────
                const starGeo = new THREE.BufferGeometry();
                const starCount = 500;
                const starPos = new Float32Array(starCount * 3);
                const spread = 7.0;
                for (let i = 0; i < starCount * 3; i++) {
                    starPos[i] = (Math.random() - 0.5) * spread;
                }
                starGeo.setAttribute('position', new THREE.BufferAttribute(starPos, 3));
                const starMat = new THREE.PointsMaterial({
                    color: 0xffffff,
                    size: 0.008,
                    transparent: true,
                    opacity: 0.7,
                    sizeAttenuation: true,
                });
                stars = new THREE.Points(starGeo, starMat);
                stars.position.y = 0.2;
                anchor.group.add(stars);

                // ─── Tampilkan AR ──────────────────────────────────
                overlay.style.display = 'none';
                container.style.display = 'block';
                hud.style.display = 'flex';

                await mindarThree.start();

                waitAndFit();
                window.addEventListener('resize', onWindowResize);

                // ─── Animasi Loop ──────────────────────────────────
                renderer.setAnimationLoop(() => {
                    // Rotasi Saturnus
                    if (saturnGroup) {
                        saturnGroup.rotation.y += 0.003;
                    }

                    // Bintang berputar pelan
                    if (stars) stars.rotation.y += 0.0001;

                    renderer.render(scene, camera);
                });

                statusMsg.textContent = '✅ AR Saturnus aktif!';

            } catch (err) {
                console.error(err);
                statusMsg.textContent = '❌ Gagal mengakses kamera. Pastikan pakai HTTPS atau localhost, dan izin kamera diberikan.';
            }
        }

        // ─── Stop AR ───────────────────────────────────────────────
        async function stopAR() {
            window.removeEventListener('resize', onWindowResize);
            if (fitRAF) cancelAnimationFrame(fitRAF);
            if (mindarThree) {
                try {
                    await mindarThree.stop();
                } catch (_) {}
                mindarThree.renderer.setAnimationLoop(null);
            }
            container.style.display = 'none';
            hud.style.display = 'none';
            overlay.style.display = 'flex';
            statusMsg.textContent = '';
            saturnGroup = null;
            saturnMesh = null;
            ringGroup = null;
            stars = null;
        }

        // ─── Event listeners ──────────────────────────────────────
        startBtn.addEventListener('click', startAR);
        stopBtn.addEventListener('click', stopAR);
    </script>
</body>
</html>
